# Copy to .dev.vars for local `wrangler dev` (never commit .dev.vars)

APP_ID=123456
WEBHOOK_SECRET=replace-with-your-webhook-secret
# PKCS#8 PEM; use \n for newlines if stored on one line, or a real multiline value in .dev.vars
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GEMINI_API_KEY=your-google-ai-studio-key
# Optional free-tier Groq fallback (skip by leaving unset)
GROQ_API_KEY=
# Workers AI uses the wrangler `[ai]` binding (no API key). Optional: delete stale
# OPENROUTER_API_KEY from Cloudflare if you previously set it:
#   npx wrangler secret delete OPENROUTER_API_KEY
# Optional paid OpenAI-compatible provider (tried before the free tiers). Set
# BOTH the key and the model, or neither; a lone key is skipped with a warning.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.6-terra
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_REASONING_EFFORT=low
# OPENAI_MAX_TOKENS_FIELD=max_completion_tokens
